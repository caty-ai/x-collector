DATABASE_URL=postgresql://user:pass@localhost:5432/x_collector

# Owner decision #3: offer eligible sources for community contribution; never sends without interactive consent.
COMMUNITY_CONTRIBUTE_PROMPT=on

# Auth.js / NextAuth (Google OAuth)
AUTH_SECRET=replace_with_long_random_secret
AUTH_GOOGLE_ID=your_google_oauth_client_id
AUTH_GOOGLE_SECRET=your_google_oauth_client_secret
NEXTAUTH_URL=http://localhost:3000

# Comma-separated Google account allowlist. Gates Google sign-in, every
# NextAuth-protected route, /admin, and /api/admin/**. Comparison trims and
# lowercases. Unset or empty denies everyone (fail-close). Use the primary
# address shown at myaccount.google.com; Gmail dot/plus variants, googlemail.com,
# and Workspace aliases do not match unless listed exactly.
# ADMIN_EMAIL_ALLOWLIST=you@example.com

SCRAPECREATORS_API_KEY=your_api_key_here

# Optional: raises GitHub API rate limits for the GitHub collector
# (works without it, but unauthenticated requests are limited to 60/h)
# GITHUB_TOKEN=

# BFF upstream base URL. The feed/newspaper UI reads through /api/bff/* proxy
# routes, so this must be set for those screens to work.
# Single-instance local setup: point it at this app itself: http://localhost:3000
RAILWAY_API_BASE_URL=https://your-app.up.railway.app

# API key fallback order for newsletter BFF routes (server-side only):
# NEWSLETTER_API_KEY -> DIGEST_API_KEY -> FEED_API_KEY
# Self-issued: any long random string you choose. At least FEED_API_KEY must be
# set for the feed/newspaper UI (via BFF) and the Feed API to respond.
NEWSLETTER_API_KEY=your_newsletter_api_key_here
DIGEST_API_KEY=your_digest_api_key_here
FEED_API_KEY=your_feed_api_key_here

TRANSCRIPT_PROVIDER=transcriptapi
TRANSCRIPTAPI_API_KEY=your_transcriptapi_key_here
LINK_ENRICH_MAX_URLS_PER_ITEM=3
LINK_ENRICH_MAX_LINKS_PER_ITEM=20
LINK_ENRICH_TIMEOUT_MS=8000
LINK_ENRICH_MAX_RETRIES=2
LINK_ENRICH_MAX_FETCH_CHARS=220000
LINK_ENRICH_MAX_TEXT_CHARS=8000
LINK_ENRICH_MAX_CLASSIFY_CONTEXT_CHARS=1000
OPENROUTER_API_KEY=your_openrouter_api_key_here
CLASSIFY_MODEL=google/gemini-3.1-flash-lite-preview
STEP4_CROSSLINK_LLM_MODEL=google/gemini-3.1-flash-lite-preview
PROD_CLASSIFY_LIMIT=600
STEP4_CROSSLINK_LIMIT=600
# Optional Step4 LLM batch size (default: 45; values are clamped to 30-150)
# STEP4_CROSSLINK_BATCH_SIZE=45
STEP6_VOICESIGNAL_LIMIT=400
STEP5_PUBLISH_LIMIT=120
STEP5_COMPOSE_MODE=script
STEP5_COMPOSE_MODEL=google/gemini-3.1-flash-lite-preview
STEP5_COMPOSE_MIN_ITEMS_PER_DENSE_SECTION=3
STEP5_COMPOSE_DENSE_SECTION_MIN_CANDIDATES=3
STEP5_COMPOSE_DENSITY_RETRY_MAX=1
STEP5_SCRIPT_MAX_PER_SECTION=0
STEP5_SCRIPT_SUMMARY_MAX_CHARS=220
STEP_LOCALIZE_JA=false

# Step 4.5: Topic Cluster (embedding-based cross-batch dedup + headline boost)
# Set to "true" to enable; leave unset/false for no-op (backward-compatible)
STEP_TOPIC_CLUSTER_ENABLED=false
STEP_TOPIC_CLUSTER_COSINE_THRESHOLD=0.84
STEP_HEADLINE_CLUSTER_BETA=8
STEP_HEADLINE_CLUSTER_GAMMA=0.5
STEP_EMBED_MODEL=openai/text-embedding-3-small
STEP_EMBED_ENDPOINT=https://openrouter.ai/api/v1/embeddings
STEP_EMBED_BATCH_SIZE=64
STEP_EMBED_MAX_RETRIES=3

# Discovery / topic-cluster / published-edition lookbacks
# PROD_DISCOVER_FETCH_LIMIT=20
# PROD_DISCOVER_EVAL_LIMIT=20
# DISCOVER_EXTRACT_LOOKBACK_DAYS=7
# STEP_TOPIC_CLUSTER_MAX_ITEMS=2000
# CROSSLINK_PUBLISHED_LOOKBACK_DAYS=90

# Family Feed API
FAMILY_FEED_API_KEY=   # unset = open dev mode; set = require Authorization: Bearer <key>

# Optional MCP server gate. Falls back to FAMILY_FEED_API_KEY; both unset = open dev mode.
MCP_API_KEY=
# Required on serverless/split deployments: this app's reachable base URL for MCP tool self-fetches.
MCP_SELF_BASE_URL=

# Product branding. Optional; leaving unset preserves current behavior.
# Build/start-time values: read once at module load; the page title is baked into prerendered HTML at `next build`.
# After changing these on a hosting dashboard, rebuild and redeploy; restarting alone is not enough.
# Display name (default: "X Collector")
PRODUCT_NAME=
# Machine slug for MCP identity and User-Agent product tokens (default: "x-collector")
PRODUCT_SLUG=
# Contact URL for outbound User-Agent strings (default: "+https://github.com/caty-ai/x-collector")
# Also used by the newsletter/og-image User-Agent (OG_FETCH_UA_CONTACT → UA_CONTACT → built-in default).
UA_CONTACT=

# Newspaper masthead (紙面題字). Optional; default: "AI Daily News". Ops example: 夕刊AIタイムズ
NEWSPAPER_MASTHEAD=
# Reader-facing subtitle under the masthead. Optional; default: "AIの最新ニュースを、毎日ひとつの紙面に。"
NEWSPAPER_TAGLINE=
# Absolute site URL used for og:url / metadataBase on /calendar. Optional; falls back to NEXTAUTH_URL.
NEWSPAPER_SITE_URL=
# Optional footer credit link; rendered only when BOTH are set (label + http(s) URL).
NEWSPAPER_POWERED_BY_LABEL=
NEWSPAPER_POWERED_BY_URL=
# Public footer "Source: GitHub" link. Default: https://github.com/caty-ai/x-collector ; "off" hides it.
NEWSPAPER_SOURCE_REPO_URL=
# X account shown as a follow button on article pages; empty = hidden (@ optional, 1-15 letters/digits/underscore; invalid = hidden)
NEWSPAPER_X_FOLLOW_HANDLE=
# Public reader mode (opt-in, default off). "1" or "true" lets anonymous visitors read /calendar,
# the newsletter BFF (format=markdown / json) and /calendar/* static assets. Everything else
# (/, /feed, /settings, /admin, other /api/bff/*) still requires an allowlisted Google account.
# With the switch on, /api/bff/og-image only resolves URLs that appear in a published edition.
# 読み取りはリクエスト時。再起動で反映（ビルド時に env を焼き込むホストでは再デプロイ）。
NEWSPAPER_PUBLIC=

# Shared newspaper gate (single ID+PW for /calendar, no NextAuth account)
NEWSPAPER_SHARED_ID=
NEWSPAPER_SHARED_PASSWORD=
