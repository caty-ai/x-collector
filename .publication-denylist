# .publication-denylist — x-collector の公開禁止パターン (NAME<TAB>REGEX / # コメント可)
# ポリシー: パターン自体も公開されるため、機微文字列の生値はここに書かない。
# 生値そのものを検査したい場合は CI secret 経由 (--denylist "$PUBLICATION_DENYLIST_PATH") を使う。
# `local-user-path` / `windows-user-path` は `<name>` と `{name}` のプレースホルダだけ除外し、`/home/youruser` は通常どおり検出する。
# `windows-user-path` は Windows パス意味論に合わせて大文字小文字を区別しない（ドライブ文字も任意）。
internal-tailscale-ip	\b100\.(?:6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])\.[0-9]{1,3}\.[0-9]{1,3}\b
internal-tailnet-host	\b[A-Za-z0-9-]+\.ts\.net\b
local-user-path	(?-i:/Users/|/home/(?![<{])[A-Za-z0-9._-]+)
windows-user-path	\b[A-Za-z]:[\\/]+Users[\\/]+(?![<{])[A-Za-z0-9._-]+
